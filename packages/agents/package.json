{
  "name": "@workspace/agents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo build dist node_modules",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1009.0",
    "@e2b/desktop": "^2.2.2",
    "@t3-oss/env-nextjs": "0.13.8",
    "@workspace/auth": "workspace:*",
    "@workspace/database": "workspace:*",
    "pg-boss": "^11.1.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4.21.0"
  },
  "prettier": "@workspace/prettier-config",
  "exports": {
    ".": "./src/index.ts",
    "./boss": "./src/boss.ts",
    "./constants": "./src/constants.ts",
    "./encryption": "./src/encryption.ts",
    "./keys": "./keys.ts",
    "./policies": "./src/policies.ts",
    "./provider-clients": "./src/provider-clients.ts",
    "./provider-types": "./src/provider-types.ts",
    "./queue": "./src/queue.ts",
    "./templates": "./src/templates.ts"
  }
}
