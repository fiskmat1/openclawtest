model ApprovalRequest {
  id                 String                @id(map: "PK_ApprovalRequest") @default(uuid()) @db.Uuid
  organizationId     String                @db.Uuid
  teamId             String                @db.Uuid
  runId              String?               @db.Uuid
  stepId             String?               @db.Uuid
  requestedByAgentId String?               @db.Uuid
  reviewedByUserId   String?               @db.Uuid
  kind               ApprovalRequestKind
  status             ApprovalRequestStatus @default(PENDING)
  riskLevel          ApprovalRiskLevel     @default(MEDIUM)
  title              String                @db.VarChar(255)
  description        String?               @db.Text
  requestedAction    Json?
  expiresAt          DateTime?
  resolvedAt         DateTime?
  decisionReason     String?               @db.VarChar(2000)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team               AgentTeam             @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  run                AgentRun?             @relation(fields: [runId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  step               AgentRunStep?         @relation(fields: [stepId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requestedByAgent   Agent?                @relation("RequestedByAgent", fields: [requestedByAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedBy         User?                 @relation("ReviewedApprovalRequests", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId], map: "IX_ApprovalRequest_organizationId")
  @@index([teamId], map: "IX_ApprovalRequest_teamId")
  @@index([runId], map: "IX_ApprovalRequest_runId")
  @@index([stepId], map: "IX_ApprovalRequest_stepId")
}

